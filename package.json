{
  "name": "designsystem-boilerplate",
  "author": "Outsystems",
  "description": "A sample monorepo repository for orgnizations looking to create their own stencil-based component library",
  "version": "0.0.1",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "apps:build": "run-s apps:build:*",
    "apps:build:angular": "echo \"Fix Angular build\" || pnpm --filter @apps/angular run build",
    "apps:build:react": "pnpm --filter @apps/react run build",
    "apps:build:vue": "pnpm --filter @apps/vue run build",
    "apps:build:next": "pnpm --filter @apps/next run build",
    "apps:build:nuxt": "pnpm --filter @apps/nuxt run build",
    "apps:build:storybook": "pnpm --filter @apps/storybook run build",
    "build": "run-s build:*",
    "build:core": "pnpm --filter @placid/core run build",
    "build:frameworks": "pnpm --filter @placid/vue --filter @placid/react --filter angular-workspace run build",
    "build:frameworks:vue": "pnpm --filter @placid/vue run build",
    "build:frameworks:react": "pnpm --filter @placid/react run build",
    "build:frameworks:angular": "pnpm --filter angular-workspace run build",
    "start:core": "pnpm --filter @placid/core run start",
    "start:react": "pnpm --filter @apps/react run start",
    "start:vue": "pnpm --filter @apps/vue run start",
    "start:next": "pnpm --filter @apps/next run start",
    "start:nuxt": "pnpm --filter @apps/nuxt run start",
    "start:angular": "pnpm --filter @apps/angular run start",
    "start:storybook": "pnpm --filter @apps/storybook run start"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stencil-community/designsystem-boilerplate.git"
  },
  "keywords": [
    "stencil",
    "component library",
    "ionic"
  ],
  "devDependencies": {
    "npm-run-all2": "^6.2.2"
  },
  "packageManager": "pnpm@9.15.1+sha512.1acb565e6193efbebda772702950469150cf12bcc764262e7587e71d19dc98a423dff9536e57ea44c49bdf790ff694e83c27be5faa23d67e0c033b583be4bfcf"
}
