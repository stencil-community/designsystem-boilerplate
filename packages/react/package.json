{
  "name": "@placid/react",
  "version": "0.0.1",
  "description": "React wrapper for Stencil component library",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/components.js",
      "types": "./dist/components.d.ts"
    },
    "./next": {
      "import": "./dist/next.js",
      "types": "./dist/next.d.ts"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ionic-team/stencil-component-starter.git"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^22.15.29",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "typescript": "^5.8.3"
  },
  "license": "MIT",
  "dependencies": {
    "@placid/core": "workspace:*",
    "@stencil/react-output-target": "^1.0.3",
    "@stencil/ssr": "^0.1.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  }
}
