{
  "name": "@placid/core",
  "version": "0.0.1",
  "description": "Stencil Component Starter",
  "main": "dist/index.cjs.js",
  "module": "dist/index.js",
  "types": "dist/types/index.d.ts",
  "collection": "dist/collection/collection-manifest.json",
  "collection:main": "dist/collection/index.js",
  "unpkg": "dist/core/core.esm.js",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/core/core.esm.js",
      "require": "./dist/core/core.cjs.js",
      "types": "./dist/types/index.d.ts"
    },
    "./components": {
      "import": "./components/index.js",
      "types": "./components/index.d.ts"
    },
    "./components/my-component.js": {
      "import": "./components/my-component.js",
      "types": "./components/my-component.d.ts"
    },
    "./components/my-counter.js": {
      "import": "./components/my-counter.js",
      "types": "./components/my-counter.d.ts"
    },
    "./loader": {
      "import": "./loader/index.js",
      "require": "./loader/index.cjs",
      "types": "./loader/index.d.ts"
    },
    "./hydrate": {
      "import": "./hydrate/index.mjs",
      "require": "./hydrate/index.js",
      "types": "./hydrate/index.d.ts"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/stencil-community/designsystem-boilerplate.git"
  },
  "files": [
    "dist/",
    "loader/"
  ],
  "scripts": {
    "build": "stencil build && pnpm copy:css",
    "start": "stencil build --dev --watch --serve",
    "test": "stencil test --spec --e2e",
    "test.watch": "stencil test --spec --e2e --watchAll",
    "generate": "stencil generate",
    "copy:css": "node scripts/copy-css.js"
  },
  "devDependencies": {
    "@stencil/angular-output-target": "^1.1.1",
    "@stencil/react-output-target": "^1.0.3",
    "@stencil/vue-output-target": "^0.10.7",
    "@stencil/core": "^4.39.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.15.29",
    "jest": "^29.7.0",
    "jest-cli": "^29.7.0",
    "puppeteer": "^24.10.0",
    "rollup": "^4.41.1",
    "rollup-plugin-sourcemaps": "^0.6.3",
    "typescript": "^5.8.3"
  },
  "license": "MIT"
}
